% 10_fruit_color_backtracking.pl
% Write a Prolog Program for fruit and its color using Back Tracking.

:- initialization(run).

run :-
    write('=== Program 10: Fruit and Color (Backtracking) ==='), nl,
    write('All fruit-color pairs (generated by backtracking):'), nl,
    fruit_color(Fruit, Color),
    write('  '), write(Fruit), write(' is '), write(Color), nl,
    fail.
run :-
    nl,
    write('Query: Which fruits are red?'), nl,
    fruit_color(F, red),
    write('  '), write(F), nl, fail.
run :-
    nl,
    write('Query: What color is banana?'), nl,
    fruit_color(banana, C),
    write('  banana is '), write(C), nl, fail.
run :-
    write('Program completed successfully.'), nl,
    halt.

% Facts - backtracking will explore all combinations
fruit(apple).
fruit(banana).
fruit(grape).
fruit(orange).
fruit(strawberry).
fruit(mango).

color(apple, red).
color(apple, green).
color(banana, yellow).
color(grape, green).
color(grape, purple).
color(orange, orange).
color(strawberry, red).
color(mango, yellow).
color(mango, green).

fruit_color(F, C) :- fruit(F), color(F, C).
