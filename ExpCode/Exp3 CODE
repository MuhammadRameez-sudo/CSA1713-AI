from collections import deque
import math


def is_solvable(cap1, cap2, target):
    """
    By Bézout's identity, the target amount can be measured if and only if:
    1. The target is not greater than the maximum jug capacity.
    2. The target is a multiple of the greatest common divisor (GCD) of both capacities.
    """
    if target > max(cap1, cap2):
        return False
    return target % math.gcd(cap1, cap2) == 0


def solve_water_jug_bfs(cap1, cap2, target):
    """
    Finds the shortest sequence of steps to measure `target` liters
    using jugs of capacity `cap1` and `cap2`.
    """
    if not is_solvable(cap1, cap2, target):
        return None

    # State: (jug1_amount, jug2_amount)
    initial_state = (0, 0)
    
    # Queue stores: (current_state, path_of_actions)
    queue = deque([(initial_state, [])])
    visited = {initial_state}

    while queue:
        (j1, j2), path = queue.popleft()

        # Goal check: either jug holds the target quantity
        if j1 == target or j2 == target:
            return path + [((j1, j2), "Goal reached")]

        # Generate all 6 possible transitions
        next_moves = []

        # 1. Fill Jug 1
        next_moves.append(((cap1, j2), f"Fill Jug 1 -> ({cap1}, {j2})"))

        # 2. Fill Jug 2
        next_moves.append(((j1, cap2), f"Fill Jug 2 -> ({j1}, {cap2})"))

        # 3. Empty Jug 1
        next_moves.append(((0, j2), f"Empty Jug 1 -> (0, {j2})"))

        # 4. Empty Jug 2
        next_moves.append(((j1, 0), f"Empty Jug 2 -> ({j1}, 0)"))

        # 5. Pour Jug 1 into Jug 2 until Jug 2 is full or Jug 1 is empty
        pour_1_to_2 = min(j1, cap2 - j2)
        next_moves.append((
            (j1 - pour_1_to_2, j2 + pour_1_to_2),
            f"Pour Jug 1 into Jug 2 -> ({j1 - pour_1_to_2}, {j2 + pour_1_to_2})"
        ))

        # 6. Pour Jug 2 into Jug 1 until Jug 1 is full or Jug 2 is empty
        pour_2_to_1 = min(j2, cap1 - j1)
        next_moves.append((
            (j1 + pour_2_to_1, j2 - pour_2_to_1),
            f"Pour Jug 2 into Jug 1 -> ({j1 + pour_2_to_1}, {j2 - pour_2_to_1})"
        ))

        # Enqueue unvisited states
        for next_state, action in next_moves:
            if next_state not in visited:
                visited.add(next_state)
                queue.append((next_state, path + [((j1, j2), action)]))

    return None


# ---------------- Example Usage ----------------
if __name__ == "__main__":
    # Classic instance: 4-gallon jug, 3-gallon jug, target = 2 gallons
    jug1_capacity = 4
    jug2_capacity = 3
    target_amount = 2

    print(f"Capacities: Jug 1 = {jug1_capacity}L, Jug 2 = {jug2_capacity}L")
    print(f"Target: {target_amount}L\n")

    steps = solve_water_jug_bfs(jug1_capacity, jug2_capacity, target_amount)

    if steps is None:
        print("No solution exists for these capacities and target.")
    else:
        print(f"Optimal solution found in {len(steps) - 1} steps:\n")
        print("Step 0: Start at state (0, 0)")
        for i, (state, action) in enumerate(steps[:-1], start=1):
            print(f"Step {i}: {action}")
        final_state, _ = steps[-1]
        print(f"\nFinal State: Jug 1 = {final_state[0]}L, Jug 2 = {final_state[1]}L")
