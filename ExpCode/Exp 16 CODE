import numpy as np

# Input data
X = np.array([[0, 0], [0, 1], [1, 0], [1, 1]])

# Output data
y = np.array([[0], [1], [1], [0]])

# Initialize weights and bias
np.random.seed(1)
w1 = np.random.rand(2, 3)
w2 = np.random.rand(3, 1)
b1 = np.zeros((1, 3))
b2 = np.zeros((1, 1))

# Activation function
def sigmoid(x):
    return 1 / (1 + np.exp(-x))

# Feed Forward
hidden = sigmoid(np.dot(X, w1) + b1)
output = sigmoid(np.dot(hidden, w2) + b2)

print("Input:")
print(X)

print("Output:")
print(output)
