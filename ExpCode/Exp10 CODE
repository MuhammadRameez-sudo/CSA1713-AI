import heapq


class Node:

  def __init__(self, position, parent=None):
    self.position = position  # (row, col)
    self.parent = parent  # Reference to preceding node

    self.g = 0  # Cost from start to current node
    self.h = 0  # Heuristic estimate to target
    self.f = 0  # Total estimated cost (f = g + h)

  # Custom comparator for the priority queue (heapq)
  def __lt__(self, other):
    return self.f < other.f


def manhattan_distance(p1, p2):
  """Heuristic function: Manhattan distance on a 4-directional grid."""
  return abs(p1[0] - p2[0]) + abs(p1[1] - p2[1])


def astar(grid, start, end):
  """Executes the A* pathfinding algorithm on a 2D binary grid.

  0 = walkable space, 1 = obstacle.
  """
  rows, cols = len(grid), len(grid[0])

  # Boundary and obstacle checks on start/end points
  if grid[start[0]][start[1]] == 1 or grid[end[0]][end[1]] == 1:
    return None

  start_node = Node(start)
  end_node = Node(end)

  # Priority queue for open set: stores (f_cost, counter, node)
  # A counter is used as a tie-breaker so nodes with equal f are handled FIFO
  counter = 0
  open_set = []
  heapq.heappush(open_set, (start_node.f, counter, start_node))

  # Track the lowest g-score discovered for each position
  g_scores = {start: 0}

  # Orthogonal movements: Up, Down, Left, Right
  directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]

  while open_set:
    _, _, current_node = heapq.heappop(open_set)

    # Reached destination: reconstruct and return the path
    if current_node.position == end_node.position:
      path = []
      curr = current_node
      while curr:
        path.append(curr.position)
        curr = curr.parent
      return path[::-1]  # Reverse to start -> end order

    # Explore neighbors
    for dr, dc in directions:
      nr, nc = current_node.position[0] + dr, current_node.position[1] + dc
      neighbor_pos = (nr, nc)

      # Check grid boundaries
      if not (0 <= nr < rows and 0 <= nc < cols):
        continue

      # Skip obstacles
      if grid[nr][nc] == 1:
        continue

      tentative_g = current_node.g + 1

      # If position has already been reached with a lower or equal cost, skip
      if (
          neighbor_pos in g_scores
          and tentative_g >= g_scores[neighbor_pos]
      ):
        continue

      # Record better score and add to open queue
      g_scores[neighbor_pos] = tentative_g
      neighbor_node = Node(neighbor_pos, current_node)
      neighbor_node.g = tentative_g
      neighbor_node.h = manhattan_distance(neighbor_pos, end)
      neighbor_node.f = neighbor_node.g + neighbor_node.h

      counter += 1
      heapq.heappush(open_set, (neighbor_node.f, counter, neighbor_node))

  return None  # No path exists


