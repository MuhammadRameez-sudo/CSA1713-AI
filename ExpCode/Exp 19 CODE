% 03_student_teacher_sub.pl
% Write a Prolog Program for STUDENT-TEACHER-SUB-CODE.

:- initialization(run).

run :-
    write('=== Program 03: Student - Teacher - Subject Code ==='), nl,
    write('All student-teacher-subject records:'), nl,
    teaches(Teacher, Subject, Code),
    student(Student, Subject),
    write('  Student: '), write(Student),
    write(', Subject: '), write(Subject),
    write(' ('), write(Code), write('), Teacher: '), write(Teacher), nl,
    fail.
run :-
    write('Query: Who teaches CS101?'), nl,
    teaches(T, _, 'CS101'),
    write('  Teacher: '), write(T), nl, fail.
run :-
    write('Program completed successfully.'), nl,
    halt.

